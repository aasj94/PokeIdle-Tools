{
  "manifest_version": 3,
  "name": "PokeIdle Tools by Ateforp",
  "version": "2.3.26",
  "description": "Configurações de PvE, PvP, compras, tudo automático e num painel só.",
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "https://pokeidle.io/*"
  ],
  "action": {
    "default_title": "Abrir/fechar o PokeIdle Tools by Ateforp",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://pokeidle.io/*"
      ],
      "js": [
        "engine.js",
        "catch.js",
        "autovenda.js",
        "pvp.js",
        "rmtpoke.js",
        "shinymon.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "https://pokeidle.io/*"
      ],
      "js": [
        "bridge.js"
      ],
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://pokeidle.io/*"
      ],
      "js": [
        "gyarados.js",
        "qrcode.min.js",
        "panel-style.js",
        "releases.js",
        "ui.js",
        "panel.js"
      ],
      "run_at": "document_end"
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}