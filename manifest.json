{
  "manifest_version": 3,
  "name": "PokeIdle Ateforp Tools",
  "version": "1.6.2",
  "description": "Ferramentas para o pokeidle.io: auto captura (Gyarados), reposição automática de estoque e compra automática no Mercado da Comunidade, num painel só.",
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "https://pokeidle.io/*"
  ],
  "action": {
    "default_title": "Abrir/fechar o PokeIdle Ateforp Tools"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://pokeidle.io/*"
      ],
      "js": [
        "engine.js",
        "catch.js",
        "autovenda.js",
        "pvp.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "https://pokeidle.io/*"
      ],
      "js": [
        "bridge.js"
      ],
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://pokeidle.io/*"
      ],
      "js": [
        "gyarados.js",
        "qrcode.min.js",
        "panel-style.js",
        "ui.js",
        "panel.js"
      ],
      "run_at": "document_end"
    }
  ]
}